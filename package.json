{
  "private": true,
  "author": "Thomas Schorn <thomas@schorn.ai>",
  "description": "schorn.ai in a Box",
  "workspaces": [
    "apps/*",
    "external/downloads",
    "packages/*"
  ],
  "scripts": {
    "build:service": "npm run build --workspace packages/service",
    "build:cli": "npm run build --workspace apps/cli",
    "service": "node apps/cli/bin/schornai.js service",
    "seed:reset": "node scripts/seed-reset.mjs",
    "test": "node scripts/test-all.mjs",
    "i18n:check": "node scripts/check-translations.mjs",
    "dev:web": "turbo dev --filter @schornio/aibox-app-web --filter @schornio/aibox-app-realtime --filter @schornio/aibox-app-proxy --filter @schornio/aibox-app-document-extractor --filter @schornio/aibox-app-transcriber-mac",
    "dev:service": "node --watch --watch-preserve-output packages/service/src/dev.ts",
    "supabase:migrate": "npx supabase db diff --schema public,storage",
    "supabase:types": "node scripts/supabase-types.mjs",
    "external:downloads": "npm run download --workspace external/downloads",
    "build:app:realtime": "rollup --config apps/realtime/rollup.config.js",
    "build:app:transcriberMac": "rollup --config apps/transcriber-mac/rollup.config.js && npm run build --workspace apps/transcriber-mac",
    "xrag:bundle": "node ./packages/xrag/update/bundleUpdate.mts",
    "knip": "knip",
    "test:watch": "vitest",
    "test:coverage": "node scripts/test-all.mjs --coverage",
    "test:scope": "node scripts/test-scope.mjs",
    "test:js": "vitest run",
    "test:python": "node scripts/test-python.mjs",
    "test:python:coverage": "node scripts/test-python.mjs --coverage",
    "storybook:web": "npm run storybook --workspace apps/web",
    "storybook:ui": "npm run storybook --workspace packages/ui",
    "storybook:build": "npm run build-storybook --workspace packages/ui && npm run build-storybook --workspace apps/web && npm run build-storybook --workspace apps/admin-mac",
    "storybook:check": "node scripts/storybook/check-coverage.mjs",
    "storybook:test": "node scripts/storybook/test-stories.mjs",
    "storybook:typecheck": "npm run typecheck-storybook --workspace apps/web && npm run typecheck-storybook --workspace packages/ui && npm run typecheck-storybook --workspace apps/admin-mac",
    "storybook:visual": "node scripts/storybook/visual.mjs",
    "storybook:visual:update": "node scripts/storybook/visual.mjs --update-snapshots=all",
    "storybook:visual:report": "playwright show-report playwright-report/storybook-visual",
    "storybook:admin": "npm run storybook --workspace apps/admin-mac",
    "test:sql": "node scripts/test-sql.mjs"
  },
  "devDependencies": {
    "@ai-sdk/mcp": "2.0.93",
    "@ai-sdk/openai": "4.0.111",
    "@ai-sdk/provider-utils": "5.0.76",
    "@hocuspocus/extension-database": "^4.7.1",
    "@hocuspocus/provider": "^4.7.1",
    "@hocuspocus/provider-react": "^4.7.1",
    "@hocuspocus/server": "^4.7.1",
    "@playwright/test": "^1.65.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.1.0",
    "ai": "7.0.166",
    "i18next": "^27.0.0",
    "jose": "^6.2.12",
    "jsdom": "^31.0.0",
    "knip": "^6.44.1",
    "next": "16.4.5",
    "next-i18next": "^16.4.1",
    "prettier": "^3.9.10",
    "react-i18next": "^18.0.0",
    "rollup": "^4.67.4",
    "standardwebhooks": "1.1.1",
    "tar": "7.5.22",
    "tinyglobby": "^0.2.17",
    "turbo": "^2.11.9",
    "tus-js-client": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33"
  },
  "packageManager": "npm@12.2.2",
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.19.1"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.2.0"
    }
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/schornai/schornai.git"
  },
  "homepage": "https://schorn.ai",
  "bugs": {
    "url": "https://github.com/schornai/schornai/issues"
  },
  "engines": {
    "node": ">=24"
  }
}
