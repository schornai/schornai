// The bundle includes a self-contained installer built with the service.
// @ts-expect-error Generated by npm run build:service when packaging the update.
import { installUpdate } from "./apps/service/installer.mjs";

console.log("Update started");
try {
  await installUpdate(import.meta.dirname);
  console.log("Update finished");
} catch (error) {
  console.error(
    "Update failed",
    error instanceof Error ? error.message : "Unknown error",
  );
  process.exitCode = 1;
}
