# Public OAuth protocol endpoints must not allow unbounded registration/token floods.
# Use the connection address, never a caller-supplied forwarding header.
limit_req_zone $binary_remote_addr zone=platform_oauth_register:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=platform_oauth_tokens:10m rate=120r/m;

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_tokens off;

    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Port $server_port;

    ssl_certificate /app/cert/fullkey.pem;
    ssl_certificate_key /app/cert/privkey.pem;

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 20m;

    # Prevent 502 errors from large Supabase auth cookies
    large_client_header_buffers 4 16k;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    location = /api/platform-mcp/register {
        client_max_body_size 32k;
        limit_req zone=platform_oauth_register burst=10 nodelay;
        limit_req_status 429;
        proxy_pass ${WEB_ENV_URL};
        proxy_redirect ${WEB_ENV_URL} /;
    }

    location ~ ^/api/platform-mcp/(token|revoke)$ {
        client_max_body_size 32k;
        limit_req zone=platform_oauth_tokens burst=30 nodelay;
        limit_req_status 429;
        proxy_pass ${WEB_ENV_URL};
        proxy_redirect ${WEB_ENV_URL} /;
    }

    location / {
        proxy_pass ${WEB_ENV_URL};
        proxy_redirect ${WEB_ENV_URL} /;
    }

    location /v2/realtime {
        proxy_pass ${REALTIME_ENV_URL};

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 3600s;
    }

    location /auth {
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_pass ${SUPABASE_ENV_HOST};
    }

    location /sso {
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_pass ${SUPABASE_ENV_HOST};
    }

    location /_next/hmr {
        proxy_pass ${WEB_ENV_URL}/_next/hmr;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 3600s;
    }

}
