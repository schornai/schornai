{
  "name": "schornai",
  "version": "0.3.0",
  "description": "The schorn.ai CLI, including machine service commands.",
  "type": "module",
  "bin": {
    "schornai": "bin/schornai.js"
  },
  "files": [
    "bin/",
    "dist/",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/schornai.js",
    "build": "npm run build --workspace @schornio/aibox-package-service && node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://schorn.ai",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@schornio/aibox-package-service": "*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/schornai/schornai.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/schornai/schornai/issues"
  }
}
